# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-random-secret-key-change-this-in-production
SESSION_MAX_AGE=86400000

# Authentication
PASSWORD=your-secure-password-here

# File Upload Configuration
UPLOAD_DIR=/var/www/tmp/receive-files
DOWNLOAD_DIR=/var/www/tmp/download-files
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/zip
